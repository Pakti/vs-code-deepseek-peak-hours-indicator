{
  "name": "vs-code-deepseek-peak-hours-indicator",
  "displayName": "DeepSeek Peak Hours Indicator",
  "description": "Shows DeepSeek UTC peak hours in the VS Code status bar, excluding Chinese public holidays.",
  "version": "0.1.0",
  "publisher": "pakti",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "colors": [
      {
        "id": "deepseekPeakHours.peakForeground",
        "description": "Text color during DeepSeek peak hours.",
        "defaults": {
          "dark": "#ff4500",
          "light": "#ff4500",
          "highContrast": "#ff4500",
          "highContrastLight": "#ff4500"
        }
      },
      {
        "id": "deepseekPeakHours.offPeakForeground",
        "description": "Text color during DeepSeek off-peak hours.",
        "defaults": {
          "dark": "#3794FF",
          "light": "#3794FF",
          "highContrast": "#3794FF",
          "highContrastLight": "#3794FF"
        }
      }
    ],
    "configuration": {
      "title": "DeepSeek Peak Hours",
      "properties": {
        "deepseekPeakHours.peakLabel": {
          "type": "string",
          "default": "🐋",
          "description": "Status-bar label during peak hours."
        },
        "deepseekPeakHours.offPeakLabel": {
          "type": "string",
          "default": "🐳",
          "description": "Status-bar label outside peak hours."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && vsce package"
  },
  "dependencies": {
    "date-holidays": "^3.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pakti/vs-code-deepseek-peak-hours-indicator.git"
  }
}
